#!/usr/bin/env python3
"""
☕ Lofi Chill Top Panel Indicator & Mini Player for Pop!_OS (COSMIC Desktop)
Lives directly inside your Linux Top Panel Status Bar.
Streams 24/7 radio stations in-memory — zero music files saved to disk.

Features:
 - Top Panel animated dancing cat icon with headphones (moves to the beat)
 - Big Visual Dancing Cat Mascot inside the Control Panel UI (68x68 vector art)
 - Left-click panel icon -> Toggles interactive Mini Control UI Window
 - Independent Lofi volume control (separate from master system output)
 - Real-time Sound Wave Equalizer
 - One-click buttons for all 9 diverse radio channels
 - Auto-starts with system on login
 - All-English UI interface
"""

import sys
import os
import math
import random
import subprocess
import gi

gi.require_version('Gtk', '3.0')
gi.require_version('Gst', '1.0')
gi.require_version('Gdk', '3.0')
gi.require_version('GdkPixbuf', '2.0')

from gi.repository import Gtk, Gdk, Gst, GLib, GdkPixbuf
from dasbus.connection import SessionMessageBus
from dasbus.signal import Signal

Gst.init(None)

ICON_DIR = "/home/ryanphan/.local/share/lofi-panel/icons"

